{
  "name": "@talent/identity-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "worker": "tsx src/workers/outbox-worker.ts",
    "worker:outbox": "tsx src/workers/outbox-worker.ts",
    "test": "vitest run --config vitest.config.mts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --config vitest.config.mts",
    "test:integration": "vitest run --config vitest.config.mts tests/integration",
    "test:unit": "vitest run --config vitest.config.mts tests/unit",
    "db": "prisma",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma skills sync || exit 0",

    "db:migrate:test": "DATABASE_URL='postgresql://talent:talent@localhost:5432/talent_platform_test' prisma migrate deploy"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@talent/auth": "workspace:^",
    "@talent/errors": "workspace:^",
    "@talent/event-schemas": "workspace:*",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.4",
    "@talent/contracts": "workspace:*"
  }
}
