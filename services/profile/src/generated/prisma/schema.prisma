generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  USER
  TALENT
  PROFESSIONAL
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum TalentProfileStatus {
  ACTIVE
  CONVERTED
}

model Account {
  id     String        @id @default(uuid()) @db.Uuid
  userId String        @unique @db.Uuid
  type   AccountType
  status AccountStatus @default(ACTIVE)

  profile             Profile?
  talentProfile       TalentProfile?
  professionalProfile ProfessionalProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, status])
  @@index([createdAt])
  @@map("accounts")
}

model Profile {
  id            String  @id @default(uuid()) @db.Uuid
  accountId     String  @unique @db.Uuid
  username      String? @unique
  displayName   String?
  bio           String?
  avatarMediaId String?
  countryCode   String?
  city          String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryCode])
  @@index([createdAt])
  @@map("profiles")
}

model TalentProfile {
  id          String              @id @default(uuid()) @db.Uuid
  accountId   String              @unique @db.Uuid
  status      TalentProfileStatus @default(ACTIVE)
  score       Int                 @default(0)
  convertedAt DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([score])
  @@map("talent_profiles")
}

model ProfessionalProfile {
  id           String  @id @default(uuid()) @db.Uuid
  accountId    String  @unique @db.Uuid
  headline     String?
  organization String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("professional_profiles")
}

model ProcessedEvent {
  eventId     String   @id @db.Uuid
  eventType   String
  processedAt DateTime @default(now())

  @@index([eventType, processedAt])
  @@map("processed_events")
}
